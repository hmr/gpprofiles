#!/usr/bin/env bash
# vim: set noet syn=bash ft=sh ff=unix fenc=utf-8 ts=2 sw=0 : # GPP default modeline for bash script
# shellcheck shell=bash disable=SC1091,SC2155,SC3010,SC3021,SC3037 source=${GPP_HOME}

# netloc-switchd: switch macOS network location by SSID/BSSID.
# Requirements:
#   - bash >= 4.0
#   - macOS with `networksetup`, `ipconfig`, `scselect`
# Behavior:
#   - Poll SSID/BSSID via `ipconfig getsummary en1 | egrep "SSID|BSSID" | sed ...`
#   - Ignore BSSID "<redacted>" and any SSID/BSSID mapped to _IGNORE_ in config.
#   - Prefer BSSID match over SSID match.
#   - Unmatched goes to "Automatic".
#   - Suppress switching if ~/.supress_auto_location_switch exists.
#   - Config file (optional): $GPP_HOME/settings/personal/netloc/netloc-switchd.map
#     Format:
#       <BSSID> = <Location>
#       <SSID>  = <Location>
#     Lines starting with '#' are comments.
#     <Location> = _IGNORE_ means it's added to ignore lists.
set -uE -o pipefail

# ---- bash version check ----
if [[ -z "${BASH_VERSINFO-}" ]] || (( BASH_VERSINFO[0] < 4 )); then
  printf '[%(%F %T)T] ERROR: bash >= 4.0 is required, current: %s\n' -1 "${BASH_VERSION:-unknown}" >&2
  exit 1
fi

# ---- constants ----
: "${GPP_HOME:=${HOME}}"  # Allow GPP_HOME to be unset; default to HOME
CONFIG_FILE="${GPP_HOME}/settings/personal/netloc/netloc-switchd.map"
SUPPRESS_FILE="${HOME}/.supress_auto_location_switch"
WIFI_DEV="en1"
DEFAULT_LOCATION="Automatic"
POLL_INTERVAL_SEC=5
CHECK_SSID_COMMAND="ipconfig getsummary ${WIFI_DEV} | egrep 'SSID|BSSID' | sed -e 's/^ *//' -e 's/ : /:/'"

# ---- state ----
declare -A MAP_SSID=()        # SSID -> Location
declare -A MAP_BSSID=()       # BSSID -> Location
declare -a IGNORE_SSIDS=()    # SSIDs to ignore
declare -a IGNORE_BSSIDS=("<redacted>")  # BSSIDs to ignore (pre-seeded)
PREV_SSID=""
PREV_BSSID=""

# ---- helpers ----
TS() { printf '%(%F %T)T' -1; }
LOG() { printf '[%s] %s\n' "$(TS)" "$*"; }
ERR() { printf '[%s] ERROR: %s\n' "$(TS)" "$*" >&2; }

# Return 0 if array contains value
IN_ARRAY() {
  local needle="$1"; shift
  local x
  for x in "$@"; do [[ "$x" == "$needle" ]] && return 0; done
  return 1
}

# Get current SSID/BSSID using the mandated pipeline
GET_WIFI_SUMMARY() {
  local line ssid="" bssid=""
  # shellcheck disable=SC2016
  while IFS= read -r line; do
    case "$line" in
      SSID:*)  ssid="${line#SSID:}";;
      BSSID:*) bssid="${line#BSSID:}";;
    esac
  done < <(${CHECK_SSID_COMMAND})
  # Trim spaces
  ssid="${ssid#"${ssid%%[![:space:]]*}"}"; ssid="${ssid%"${ssid##*[![:space:]]}"}"
  bssid="${bssid#"${bssid%%[![:space:]]*}"}"; bssid="${bssid%"${bssid##*[![:space:]]}"}"
  printf '%s\t%s\n' "${ssid}" "${bssid}"
}

# Get current network location name
CURRENT_LOCATION() {
  networksetup -getcurrentlocation 2>/dev/null || true
}

# Switch location if different and not suppressed
SWITCH_LOCATION() {
  local target="$1"
  if [[ -f "${SUPPRESS_FILE}" ]]; then
    LOG "Suppressed by ${SUPPRESS_FILE}; would switch to '${target}' but skipping."
    return 0
  fi
  local cur
  cur="$(CURRENT_LOCATION)"
  if [[ "${cur}" == "${target}" ]]; then
    LOG "Already at location '${target}'. No switch."
    return 0
  fi
  LOG "Switching location: '${cur}' -> '${target}'"
  if ! networksetup -switchtolocation "${target}"; then
    ERR "Failed to switch to '${target}'"
    return 1
  fi
  return 0
}

# Parse config file. Builds MAP_SSID, MAP_BSSID, IGNORE arrays. Performs syntax checks.
LOAD_CONFIG() {
  MAP_SSID=()
  MAP_BSSID=()
  IGNORE_SSIDS=()
  IGNORE_BSSIDS=("<redacted>")

  [[ -f "${CONFIG_FILE}" ]] || { LOG "Config not found: ${CONFIG_FILE}. Continuing with defaults."; return 0; }

  local ln=0 raw key val errors=0
  while IFS= read -r raw || [[ -n "${raw}" ]]; do
    ((ln++))
    # Strip leading/trailing spaces
    local line="${raw#"${raw%%[![:space:]]*}"}"; line="${line%"${line##*[![:space:]]}"}"
    [[ -z "${line}" || "${line}" =~ ^# ]] && continue
    # Expect "LHS = RHS"
    if [[ ! "${line}" =~ ^([^=[:space:]].*[^[:space:]])[[:space:]]*=[[:space:]]*([^[:space:]].*[^[:space:]]|[^[:space:]])$ ]]; then
      ERR "Syntax error at ${CONFIG_FILE}:${ln}: ${raw}"
      ((errors++))
      continue
    fi
    key="${BASH_REMATCH[1]}"
    val="${BASH_REMATCH[2]}"

    # Decide whether key is BSSID or SSID by presence of typical BSSID pattern
    if [[ "${key}" =~ ^([0-9A-Fa-f]{2}:){5}[0-9A-Fa-f]{2}$ ]]; then
      if [[ "${val}" == "_IGNORE_" ]]; then
        IGNORE_BSSIDS+=("${key}")
      else
        MAP_BSSID["${key}"]="${val}"
      fi
    else
      # Treat as SSID
      if [[ "${val}" == "_IGNORE_" ]]; then
        IGNORE_SSIDS+=("${key}")
      else
        MAP_SSID["${key}"]="${val}"
      fi
    fi
  done < "${CONFIG_FILE}"

  if (( errors > 0 )); then
    ERR "Found ${errors} syntax error(s) in ${CONFIG_FILE}. Faulty lines were ignored."
  fi
}

# Decide target location given SSID/BSSID
DECIDE_LOCATION() {
  local ssid="$1" bssid="$2"
  # If BSSID is ignored
  if IN_ARRAY "${bssid}" "${IGNORE_BSSIDS[@]}"; then
    bssid=""
  fi
  # If SSID is ignored
  if IN_ARRAY "${ssid}" "${IGNORE_SSIDS[@]}"; then
    ssid=""
  fi
  # Prefer BSSID match
  if [[ -n "${bssid}" && -n "${MAP_BSSID[${bssid}]:-}" ]]; then
    printf '%s\n' "${MAP_BSSID[${bssid}]}"
    return 0
  fi
  # Next: SSID match
  if [[ -n "${ssid}" && -n "${MAP_SSID[${ssid}]:-}" ]]; then
    printf '%s\n' "${MAP_SSID[${ssid}]}"
    return 0
  fi
  # Fallback
  printf '%s\n' "${DEFAULT_LOCATION}"
}

# Trap to allow clean messages
ON_TERM() { LOG "Received termination signal. Exiting."; exit 0; }
trap ON_TERM INT TERM

LOG "Starting netloc-switchd for device ${WIFI_DEV}"
LOAD_CONFIG

while :; do
  # Reload config every cycle (cheap and keeps behavior dynamic)
  LOAD_CONFIG

  read -r cur_ssid cur_bssid < <(GET_WIFI_SUMMARY)
  # Skip if nothing readable yet
  if [[ -z "${cur_ssid}" && -z "${cur_bssid}" ]]; then
    sleep "${POLL_INTERVAL_SEC}"
    continue
  fi

  if [[ "${cur_ssid}" != "${PREV_SSID}" || "${cur_bssid}" != "${PREV_BSSID}" ]]; then
    LOG "Change detected: SSID='${PREV_SSID}'->'${cur_ssid}' BSSID='${PREV_BSSID}'->'${cur_bssid}'"
    SWITCH_LOCATION "$(DECIDE_LOCATION "${cur_ssid}" "${cur_bssid}")" || true
    PREV_SSID="${cur_ssid}"
    PREV_BSSID="${cur_bssid}"
  fi

  sleep "${POLL_INTERVAL_SEC}"
done
