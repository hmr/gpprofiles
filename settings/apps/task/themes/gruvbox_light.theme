###############################################################################
#  Gruvbox-Light theme for Taskwarrior  (256-colour version)
#  Palette:
#  palette 1    red          #cc241d, color124
#  pallete 2    green        #98971a, color106
#  palette 3    yellow       #d79921, color172
#  palette 4    blue         #458588, color66
#  palette 5    purple       #b16286, color132
#  palette 6    aqua         #689d6a, color72
#  palette 7    gray         #7c6f64, color243
#  palette 8    light-grey   #928374, color244
#  palette 9    dark-red     #9d0006, color88
#  palette 10   dark-green   #79740e, color100
#  palette 11   dark-yellow  #b57614, color136
#  palette 12   dark-blue    #076678, color24
#  palette 13   dark-purple  #8f3f71, color96
#  palette 14   dark-aqua    #427b58, color66
#  palette 15   fg           #3c3836, color237
#  palette 0    bg(default)  #fbf1c7, color229
#  palette 0h   bg(hard)     #f9f5d7, color230
#  palette 0s   bg(soft)     #f2e5bc, color228
#  palette X    orange       #d65d0e, color166
#  palette X    dark-orange  #af3a03, color130
#  palette X    bg3          #bbae93, color248
###############################################################################

rule.precedence.color=deleted,completed,active,keyword.,tag.,project.,overdue,scheduled,due.today,due,blocked,blocking,recurring,tagged,uda.

# This is a theme that disables all default colors
# It can be used as template for other themes

# General decoration
color.label=
color.label.sort=
# color.alternate=on color187
color.alternate=on color223
color.header=color166
color.footnote=color166
color.warning=color124
color.error=on color124
color.debug=color72

# Task state
color.completed=
color.deleted=
# color.active=on color166
color.active=on color214
color.recurring=color66
color.scheduled=on color24
color.until=
color.blocked=on color8
color.blocking=color230 on color8

# Project
color.project.none=

# Priority
color.uda.priority.H=color244
color.uda.priority.L=color229
color.uda.priority.M=color248

# Tags
color.tag.next=color106
color.tag.none=
color.tagged=

# Due
color.due=color124
color.due.today=color124
color.overdue=color88

# Report: burndown
color.burndown.done=on color106
color.burndown.pending=on color130
color.burndown.started=on color172

# Report: history
color.history.add=color230 on color124
color.history.delete=color230 on color172
color.history.done=color230 on color106

# Report: summary
color.summary.background=color244
color.summary.bar=color230 on color72

# Command: calendar
color.calendar.due=color230 on color124
color.calendar.due.today=color244 on color124
color.calendar.holiday=color230 on color172
color.calendar.overdue=color230 on color88
color.calendar.scheduled=color72 on color248
color.calendar.today=color248 on color72
color.calendar.weekend=on color248
color.calendar.weeknumber=color66

# Command: sync
color.sync.added=color106
color.sync.changed=color172
color.sync.rejected=color124

# Command: undo
color.undo.after=color106
color.undo.before=color124

