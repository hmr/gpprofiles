# Check arg is already set into PATH
function CHECK_PATH () {
  (( $# < 1 )) && return 1
  # echo "${PATH}" | grep "${1}" >& /dev/null \
  #   && return 0 \
  #   || return 1
  [[ ${PATH} =~ ${1} ]] && return 0 || return 1
}

# Add path to GNU software installed by Homebrew
function HB_ADD_PATH_GNU () {
  (( $# < 1 )) && return 1
  local HB_TARGET
  if [[ -d /opt/homebrew/opt ]]; then
    HB_TARGET="/opt/homebrew/opt/${1}/libexec/gnubin"
  elif [[ -d /usr/local/opt ]]; then
    HB_TARGET="/usr/local/opt/${1}/libexec/gnubin"
  fi

  CHECK_PATH "${HB_TARGET}" && return 1
  if [ -d "${HB_TARGET}" ]; then
		case ${2:-L} in
			H)
				ADD_INTO_PATH "${HB_TARGET}" "H"
				;;
			*)
				ADD_INTO_PATH "${HB_TARGET}"
				;;
		esac
    return 0
  else
    return 2
  fi
}

# Add path to software installed by Homebrew
function HB_ADD_PATH () {
  (( $# < 1 )) && return 1
  local HB_TARGET
  if [[ -d /opt/homebrew/opt ]]; then
    HB_TARGET="/opt/homebrew/opt/${1}/bin"
  elif [[ -d /usr/local/opt ]]; then
    HB_TARGET="/usr/local/opt/$1/bin"
  fi

  CHECK_PATH "${HB_TARGET}" && return 1
  if [ -d "${HB_TARGET}" ]; then
		case ${2:-L} in
			H)
				ADD_INTO_PATH "${HB_TARGET}" "H"
				;;
			*)
				ADD_INTO_PATH "${HB_TARGET}"
				;;
		esac
    return 0
  else
    return 2
  fi
}

