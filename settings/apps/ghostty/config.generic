# Ghostty configuration file (common)
# Part of GPP

initial-command = ~/launch_tmux localhost auto
shell-integration = detect
shell-integration-features = ssh-env, no-title

theme = light:Gruvbox Light,dark:Gruvbox Dark
font-family = Cica
font-size = 14
alpha-blending = native

background-opacity = 0.925
background-blur = 10

cursor-style = block
cursor-style-blink = false
mouse-hide-while-typing = true

# Newly created window size(not first one)
window-height = 80
window-width = 133
window-step-resize = true
window-padding-x = 5,5
title = ""

bell-features = no-system,no-audio,attention,title,border
notify-on-command-finish = always
notify-on-command-finish-after = 1m

macos-titlebar-style = tabs
macos-titlebar-proxy-icon = hidden

macos-option-as-alt = true

wait-after-command = true
mouse-scroll-multiplier = 1

app-notifications = true

auto-update = check
auto-update-channel = stable

keybind = super+arrow_left=csi:1;4D
keybind = super+arrow_right=csi:1;4C

# Include local settings if exists
config-file = ?config.local
