# Helper function
function _chksysspd() {
	local SYSSPD CPU_ARCH CPU_TYPE CPU_CLOCK
	SYSSPD=1

	case "${OSTYPE}" in
		darwin* )
			if [[ $(sysctl machdep.cpu.brand_string) =~ "Apple" ]]; then
				SYSSPD="10"
			elif [[ $(sysctl machdep.cpu.brand_string) =~ "Intel" ]]; then
				SYSSPD="4"
			else
				SYSSPD="1"
			fi;;
		linux*)
			case "$(uname -m)" in
				aarch64)
					local TMP_CPUINFO
					TMP_CPUINFO=$(cat /proc/cpuinfo)
					if [[ ${TMP_CPUINFO} =~ "Raspberry Pi 5" ]]; then
						SYSSPD="7"
					elif [[ ${TMP_CPUINFO} =~ "Raspberry Pi 4" ]]; then
						SYSSPD="3"
					else
						SYSSPD="2"
					fi
					:
					;;
				*)
					SYSSPD="2";;
			esac
			;;
		* )
			SYSSPD="5";;
	esac

	echo "${SYSSPD}"
}

