# vim: ft=zsh ts=2 sw=2 et ff=unix fenc=utf-8

# Part of GPP

# Systemwide zshenv
# Must be placed as /etc/zshenv, this file is sourced by zsh in any mode.

# ORIGIN: 2020-12-18 by hmr

# ZDOTDIR must be set here at least.
[[ -z ${XDG_CONFIG_HOME:-} ]]  && export XDG_CONFIG_HOME="$HOME/.config"
[[ -z ${XDG_CACHE_HOME:-}  ]]  && export XDG_CACHE_HOME="$HOME/.cache"
[[ -z ${XDG_DATA_HOME:-}   ]]  && export XDG_DATA_HOME="$HOME/.local/share"
[[ -z ${XDG_STATE_HOME:-}  ]]  && export XDG_STATE_HOME="$HOME/.local/state"
[[ -z ${XDG_RUNTIME_DIR:-} ]]  && export XDG_RUNTIME_DIR="$HOME/.run"
[[ -z ${ZDOTDIR:-}         ]]  && export ZDOTDIR="$HOME/.config/zsh"

# Prefix of Homebrew
if [[ -d /opt/homebrew/share/terminfo ]]; then
  export HB_PREFIX="/opt/homebrew"
elif [[ -d /usr/local/share/terminfo ]]; then
  HB_PREFIX="/usr/local"
fi
# Prefix of MacPorts
if [[ -d /opt/local/share/terminfo ]]; then
  export MP_PREFIX="/opt/local"
fi

# Use newer ncurses installed by Homebrew / MacPorts
# Disabled due to workaround
# [[ -n ${TERMINFO} ]] && unset TERMINFO  # Don't use TERMINFO variable

# Homebrew
if [[ -n ${HB_PREFIX:-} ]]; then
  HB_TERMINFO_DIRS="${HB_PREFIX}/opt/ncurses/share/terminfo"
  if [[ ! ${TERMINFO_DIRS:-} =~ ${HB_TERMINFO_DIRS} && -d ${HB_TERMINFO_DIRS} ]]; then
    export TERMINFO_DIRS="${HB_TERMINFO_DIRS}:${TERMINFO_DIRS:-}"
  fi
  unset HB_TERMINFO_DIRS
fi
# MacPorts
if [[ -n ${MP_PREFIX:-} ]]; then
  MP_TERMINFO_DIRS="${MP_PREFIX}/share/terminfo"
  if [[ ! ${TERMINFO_DIRS:-} =~ ${MP_TERMINFO_DIRS} && -d ${MP_TERMINFO_DIRS} ]]; then
    export TERMINFO_DIRS="${MP_TERMINFO_DIRS}:${TERMINFO_DIRS:-}"
  fi
  unset MP_TERMINFO_DIRS
fi
# iTerm2
ITERM_TERMINFO_DIRS="/Applications/iTerm.app/Contents/Resources/terminfo"
if [[ ! ${TERMINFO_DIRS:-} =~ ${ITERM_TERMINFO_DIRS} && -d ${ITERM_TERMINFO_DIRS} ]]; then
  export TERMINFO_DIRS="${ITERM_TERMINFO_DIRS}:${TERMINFO_DIRS:-}"
fi
unset ITERM_TERMINFO_DIRS

### Set Homebrew binary top of the PATH
if [[ -n ${HB_PREFIX:-} ]]; then
  [[ ! ${PATH} =~ ${HB_PREFIX}/bin  && -d ${HB_PREFIX}/bin  ]] && export PATH=${HB_PREFIX}/bin:${PATH}
  [[ ! ${PATH} =~ ${HB_PREFIX}/sbin && -d ${HB_PREFIX}/sbin ]] && export PATH=${HB_PREFIX}/sbin:${PATH}
fi

### Set MacPorts binary top of the PATH
if [[ -n ${MP_PREFIX:-} ]]; then
  [[ ! ${PATH} =~ ${MP_PREFIX}/bin  && -d ${MP_PREFIX}/bin  ]] && export PATH=${MP_PREFIX}/bin:${PATH}
  [[ ! ${PATH} =~ ${MP_PREFIX}/sbin && -d ${MP_PREFIX}/sbin ]] && export PATH=${MP_PREFIX}/sbin:${PATH}
fi

