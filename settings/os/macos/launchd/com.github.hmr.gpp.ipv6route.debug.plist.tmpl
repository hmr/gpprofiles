<?xml version="1.0" encoding="UTF-8"?>
<!-- vim: set ft=xml fenc=utf-8 ff=unix fixeol et sw=2 ts=2 sts=2: #GPP default modeline for XML -->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.github.hmr.gpp.ipv6route.debug</string>

  <key>ProgramArguments</key>
  <array>
    <string>__GPP_HOME__/settings/os/macos/launchd/launchd_ipv6_route</string>
  </array>

  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/usr/local/bin:/opt/local/bin:/opt/homebrew/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
  </dict>

  <key>RunAtLoad</key>
  <true/>

  <key>ProcessType</key>
  <string>Standaed</string>

  <key>StandardErrorPath</key>
  <string>__GPP_TMP_DIR__/ipv6route.stderr.log</string>

  <key>StandardOutPath</key>
  <string>__GPP_TMP_DIR__/ipv6route.stdout.log</string>
</dict>
</plist>
