<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
	<dict>
		<key>Label</key>
		<string>com.github.hmr.gpp.netlocd</string>
		<key>ProgramArguments</key>
		<array>
			<string>__GPP_HOME__/libexec/tools/netlocd</string>
		</array>
		<key>EnvironmentVariables</key>
		<dict>
			<key>PATH</key>
			<string>/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
			<key>GPP_HOME</key>
			<string>__GPP_HOME__</string>
		</dict>
		<key>RunAtLoad</key>
		<true/>
		<key>KeepAlive</key>
		<true/>
		<key>StandardErrorPath</key>
		<string>__GPP_TMP_DIR__/netlocd.stderr.log</string>
		<key>StandardOutPath</key>
		<string>__GPP_TMP_DIR__/netlocd.stdout.log</string>
	</dict>
</plist>

